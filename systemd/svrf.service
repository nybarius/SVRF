# One round of the SVRF merge train. Every path is explicit.
[Unit]
Description=SVRF merge train (one round)
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/svrf --config %h/.config/svrf/svrf.toml run --once
Nice=5
TimeoutStartSec=6h
